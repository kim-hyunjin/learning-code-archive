{
  "name": "hyunjin-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/convert-notebooks.ts && astro dev",
    "check": "node scripts/convert-notebooks.ts && astro check && node scripts/verify-content.ts",
    "test": "vitest run",
    "build": "pnpm run check && pnpm run test && astro build && pagefind --site dist && node scripts/verify-dist.ts",
    "preview": "astro preview",
    "deploy": "pnpm run build && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@starwind-ui/astro": "1.0.0",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.3",
    "katex": "0.16.29",
    "mermaid": "11.16.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sanitize-html": "2.17.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@shikijs/types": "4.3.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/sanitize-html": "2.16.1",
    "gh-pages": "6.3.0",
    "gray-matter": "4.0.3",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vitest": "4.1.10"
  }
}
